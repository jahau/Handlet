[Unit]
Description=Handlet app
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/myapp
Environment=PYTHONUNBUFFERED=1
Environment=APP_BUTTON_PIN=5
Environment=APP_LED_PIN=19
# Graphical app on the 5" screen? Use After=graphical.target and
# WantedBy=graphical.target, plus: Environment=WAYLAND_DISPLAY=wayland-0
# Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/home/pi/myapp/.venv/bin/python main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
